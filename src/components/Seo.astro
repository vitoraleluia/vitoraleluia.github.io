---
import { siteConfig } from '../site.config';
import type { CollectionEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  post?: CollectionEntry<'blog'>;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  post,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : siteConfig.siteUrl.replace(/\/$/, '');
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';

const formattedTitle = isHome
  ? (siteConfig.homeTitle || siteConfig.title)
  : title === siteConfig.title
    ? siteConfig.title
    : `${title} — ${siteConfig.title}`;

const shareTitle = isHome
  ? (siteConfig.homeTitle || siteConfig.title)
  : title;

const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

const rssUrl = new URL('/rss.xml', siteUrl).href;
const sitemapUrl = new URL('/sitemap-index.xml', siteUrl).href;

// Schema.org Structured Data (JSON-LD)
const structuredData = post
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.pubDate.toISOString(),
      dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteConfig.title,
      url: siteUrl,
      description: siteConfig.description,
    };
---

<!-- Primary Page Title & Description -->
<title>{formattedTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- RSS Feed & Sitemap Auto-Discovery -->
<link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={rssUrl} />
<link rel="sitemap" href={sitemapUrl} />

<!-- OpenGraph Meta Tags -->
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={shareTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={post ? 'article' : 'website'} />
<meta property="og:locale" content="en_US" />

<!-- Article-Specific OpenGraph Tags -->
{post && (
  <>
    <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
    <meta property="article:modified_time" content={(post.data.updatedDate || post.data.pubDate).toISOString()} />
    {post.data.tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </>
)}

<!-- Twitter Card Meta Tags -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={shareTitle} />
<meta name="twitter:description" content={description} />

<!-- Schema.org Structured Data (JSON-LD) -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
