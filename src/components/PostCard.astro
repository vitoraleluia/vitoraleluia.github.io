---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  headingLevel?: 'h2' | 'h3';
  class?: string;
}

const { post, headingLevel = 'h2', class: className = '' } = Astro.props;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

const HeadingTag = headingLevel;
---

<article class:list={['flex flex-col p-5 bg-ctp-surface0/30 hover:bg-ctp-surface0/60 border border-ctp-surface0 hover:border-ctp-peach rounded-lg transition-colors duration-150', className]}>
  <div class="mb-2">
    <time datetime={post.data.pubDate.toISOString()} class="font-mono text-xs text-ctp-overlay2">
      {formatDate(post.data.pubDate)}
    </time>
  </div>

  <HeadingTag class="text-lg font-semibold leading-snug mb-2 font-sans m-0">
    <a href={`/blog/${post.id}/`} class="text-ctp-text hover:text-ctp-peach no-underline transition-colors duration-150">
      {post.data.title}
    </a>
  </HeadingTag>

  <p class="text-sm text-ctp-subtext0 leading-relaxed m-0">{post.data.description}</p>

  {post.data.tags && post.data.tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mt-3">
      {post.data.tags.map((tag) => (
        <a
          href={`/tags/${tag}/`}
          class="text-xs font-mono text-ctp-subtext0 hover:text-ctp-peach transition-colors duration-150 no-underline"
        >
          #{tag}
        </a>
      ))}
    </div>
  )}
</article>
