---
interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl';
  src?: string;
  alt?: string;
  class?: string;
}

const {
  size = 'lg',
  src,
  alt = 'Vitor Aleluia',
  class: className = '',
} = Astro.props;

const dimensionMap = {
  sm: 40,
  md: 80,
  lg: 104,
  xl: 128,
};

const sizeClassesMap = {
  sm: 'w-10 h-10',
  md: 'w-20 h-20',
  lg: 'w-[6.5rem] h-[6.5rem]',
  xl: 'w-32 h-32',
};

const dim = dimensionMap[size];
const sizeClasses = sizeClassesMap[size];
---

<div class:list={['relative inline-block shrink-0 rounded-full border border-ctp-surface1 overflow-hidden', sizeClasses, className]}>
  {src ? (
    <img
      src={src}
      alt={alt}
      width={dim}
      height={dim}
      class="w-full h-full rounded-full object-cover bg-ctp-mantle block"
      loading="eager"
    />
  ) : (
    <div class="w-full h-full rounded-full bg-ctp-mantle block" aria-label={alt} role="img">
      <!-- Clean Theme-Adaptive SVG avatar placeholder -->
      <svg
        viewBox="0 0 100 100"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full h-full block"
      >
        <circle cx="50" cy="50" r="49" fill="var(--color-ctp-mantle)" stroke="var(--color-ctp-surface0)" stroke-width="1.5" />
        <circle cx="50" cy="40" r="17" fill="var(--color-ctp-surface2)" />
        <path
          d="M24 82C24 67.64 35.64 56 50 56C64.36 56 76 67.64 76 82"
          fill="var(--color-ctp-surface2)"
        />
      </svg>
    </div>
  )}
</div>
