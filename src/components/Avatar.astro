---
interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl';
  src?: string;
  alt?: string;
  class?: string;
}

const {
  size = 'lg',
  src,
  alt = 'Vitor Aleluia',
  class: className = '',
} = Astro.props;

const dimensionMap = {
  sm: 40,
  md: 80,
  lg: 104,
  xl: 128,
};

const dim = dimensionMap[size];
---

<div class={`avatar-wrapper ${className}`} style={`--avatar-size: ${dim}px;`}>
  {src ? (
    <img
      src={src}
      alt={alt}
      width={dim}
      height={dim}
      class="avatar-img"
      loading="eager"
    />
  ) : (
    <div class="avatar-placeholder" aria-label={alt} role="img">
      <!-- Clean neutral SVG avatar placeholder -->
      <svg
        viewBox="0 0 100 100"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="avatar-svg"
      >
        <circle cx="50" cy="50" r="49" fill="#1c1c1f" stroke="#2e2e33" stroke-width="1.5" />
        <circle cx="50" cy="40" r="17" fill="#3f3f46" />
        <path
          d="M24 82C24 67.64 35.64 56 50 56C64.36 56 76 67.64 76 82"
          fill="#3f3f46"
        />
      </svg>
    </div>
  )}
</div>

<style>
  .avatar-wrapper {
    position: relative;
    width: var(--avatar-size);
    height: var(--avatar-size);
    border-radius: 50%;
    border: 1px solid var(--sl-color-gray-5, #27272a);
    display: inline-block;
    flex-shrink: 0;
    overflow: hidden;
  }

  .avatar-img,
  .avatar-placeholder {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    background-color: var(--sl-color-gray-6, #18181b);
    display: block;
  }

  .avatar-svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
