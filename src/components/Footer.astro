---
import { siteConfig } from '../site.config';
import SocialIcons from './SocialIcons.astro';

const currentYear = new Date().getFullYear();

const footerLinks = siteConfig.socialLinks.filter(
  (item) => item.icon === 'email' || item.icon === 'rss'
);
---

<footer class="w-full border-t border-ctp-surface0 mt-auto bg-ctp-mantle/30">
  <div class="w-full max-w-7xl mx-auto px-6 sm:px-10 lg:px-16 py-6 sm:py-7 flex flex-col sm:flex-row items-center justify-between gap-4">
    <!-- Contact Links (Email and RSS only) -->
    <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2.5">
      {footerLinks.map((item) => (
        <a
          href={item.href}
          target={item.href.startsWith('http') ? '_blank' : undefined}
          rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="inline-flex items-center gap-2 px-3 py-1.5 text-xs font-medium text-ctp-subtext0 bg-ctp-surface0/40 hover:bg-ctp-surface0 border border-ctp-surface1 hover:border-ctp-peach hover:text-ctp-peach rounded-md transition-colors duration-150 no-underline"
        >
          <SocialIcons icon={item.icon} size={15} />
          <span>{item.label}</span>
        </a>
      ))}
    </div>

    <!-- Copyright -->
    <p class="font-mono text-xs text-ctp-overlay2 m-0 text-center sm:text-right shrink-0">
      &copy; <span id="footer-year">{currentYear}</span> {siteConfig.name} - Todos os direitos reservados
    </p>
  </div>
</footer>

<script>
  const yearEl = document.getElementById('footer-year');
  if (yearEl) {
    yearEl.textContent = new Date().getFullYear().toString();
  }
</script>
