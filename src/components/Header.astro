---
import { siteConfig } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === '/') return pathname === '/' || pathname === '';
  return pathname.startsWith(href);
};
---

<div class="w-full max-w-7xl h-full mx-auto flex items-center justify-between gap-6 relative">
  <!-- Brand / Name (Left) -->
  <a href="/" class="inline-flex items-center font-sans text-lg font-bold text-ctp-text hover:text-ctp-peach tracking-tight transition-colors duration-150 no-underline shrink-0">
    <span>{siteConfig.name}</span>
  </a>

  <!-- Right Controls: Desktop Nav Links + Search + Theme Toggle + Mobile Toggle -->
  <div class="flex items-center gap-3 sm:gap-4">
    <!-- Desktop Nav Links -->
    <nav class="hidden min-[680px]:flex items-center gap-1 sm:gap-2" aria-label="Main Navigation">
      {siteConfig.navLinks.map((link) => (
        <a
          href={link.href}
          target={link.target}
          rel={link.rel}
          class:list={[
            'inline-flex items-center gap-1 text-sm font-medium px-2.5 py-1.5 rounded-md transition-colors duration-150 no-underline',
            isCurrent(link.href) ? 'text-ctp-peach font-semibold' : 'text-ctp-subtext0 hover:text-ctp-text',
            link.label === 'CV' ? 'border border-ctp-surface1 hover:border-ctp-peach hover:text-ctp-peach px-2 py-1 text-xs' : '',
          ]}
          aria-current={isCurrent(link.href) ? 'page' : undefined}
        >
          {link.label}
          {link.target === '_blank' && (
            <svg class="opacity-60" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          )}
        </a>
      ))}
    </nav>

    <div class="hidden min-[680px]:block w-px h-5 bg-ctp-surface1 mx-0.5" aria-hidden="true" />

    <!-- Desktop DuckDuckGo Search (Hidden on mobile) -->
    <form
      id="ddg-search-form"
      class="relative hidden min-[680px]:flex items-center"
      role="search"
      action="https://duckduckgo.com/"
      method="get"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg class="absolute left-2.5 text-ctp-overlay0 pointer-events-none" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        id="ddg-search-input"
        type="search"
        placeholder="Search..."
        autocomplete="off"
        spellcheck="false"
        aria-label="Search this blog using DuckDuckGo"
        class="w-48 sm:w-52 focus:w-60 h-8 pl-8 pr-12 text-xs font-sans text-ctp-text placeholder-ctp-overlay0 bg-ctp-surface0 border border-ctp-surface1 rounded-md outline-none focus:border-ctp-peach transition-all duration-200"
      />
      <input type="hidden" name="q" id="ddg-final-query" value="" />
      <kbd class="absolute right-2 font-mono text-[11px] px-1.5 py-0.5 border border-ctp-surface1 rounded text-ctp-overlay0 bg-ctp-mantle pointer-events-none" aria-hidden="true">Ctrl K</kbd>
    </form>

    <div class="flex items-center">
      <ThemeToggle />
    </div>

    <!-- Mobile Hamburger Button -->
    <button
      id="mobile-nav-toggle"
      class="flex min-[680px]:hidden items-center justify-center w-9 h-9 p-0 bg-transparent border border-ctp-surface1 rounded-md text-ctp-subtext0 hover:text-ctp-text hover:border-ctp-surface2 transition-colors cursor-pointer group"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      type="button"
    >
      <svg class="hamburger-icon pointer-events-none block group-[.is-active]:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg class="close-icon pointer-events-none hidden group-[.is-active]:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu (Contains Search on mobile) -->
  <nav id="mobile-nav-menu" class="hidden [&.is-open:not([hidden])]:flex min-[680px]:!hidden fixed top-[3.75rem] left-0 right-0 w-full max-h-[calc(100vh-3.75rem)] overflow-y-auto bg-ctp-mantle border-b border-ctp-surface0 p-5 flex-col gap-5 shadow-2xl z-50" aria-label="Mobile Navigation" hidden>
    <!-- Mobile DuckDuckGo Search Form -->
    <form
      id="mobile-ddg-search-form"
      class="relative flex items-center w-full"
      role="search"
      action="https://duckduckgo.com/"
      method="get"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg class="absolute left-3 text-ctp-overlay0 pointer-events-none" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        id="mobile-ddg-search-input"
        type="search"
        placeholder="Search..."
        autocomplete="off"
        spellcheck="false"
        aria-label="Search this blog using DuckDuckGo"
        class="w-full h-9 pl-9 pr-4 text-sm font-sans text-ctp-text placeholder-ctp-overlay0 bg-ctp-surface0 border border-ctp-surface1 rounded-md outline-none focus:border-ctp-peach"
      />
      <input type="hidden" name="q" id="mobile-ddg-final-query" value="" />
    </form>

    <div class="flex flex-col gap-1.5">
      {siteConfig.navLinks.map((link) => (
        <a
          href={link.href}
          target={link.target}
          rel={link.rel}
          class:list={[
            'mobile-nav-link flex items-center justify-between px-3 py-2.5 text-base font-medium rounded-md transition-colors no-underline',
            isCurrent(link.href) ? 'text-ctp-peach bg-ctp-surface0/70 font-semibold' : 'text-ctp-subtext0 hover:text-ctp-peach hover:bg-ctp-surface0/50',
          ]}
          aria-current={isCurrent(link.href) ? 'page' : undefined}
        >
          <span>{link.label}</span>
          {link.target === '_blank' && (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          )}
        </a>
      ))}
    </div>
  </nav>
</div>

<script>
  const domain = 'vitoraleluia.com';

  // Desktop search handler
  const desktopForm = document.getElementById('ddg-search-form') as HTMLFormElement | null;
  const desktopInput = document.getElementById('ddg-search-input') as HTMLInputElement | null;
  const desktopHiddenQ = document.getElementById('ddg-final-query') as HTMLInputElement | null;

  if (desktopForm && desktopInput && desktopHiddenQ) {
    desktopForm.addEventListener('submit', (e) => {
      const val = desktopInput.value.trim();
      if (!val) {
        e.preventDefault();
        return;
      }
      desktopHiddenQ.value = `site:${domain} ${val}`;
    });
  }

  // Mobile search handler
  const mobileForm = document.getElementById('mobile-ddg-search-form') as HTMLFormElement | null;
  const mobileInput = document.getElementById('mobile-ddg-search-input') as HTMLInputElement | null;
  const mobileHiddenQ = document.getElementById('mobile-ddg-final-query') as HTMLInputElement | null;

  if (mobileForm && mobileInput && mobileHiddenQ) {
    mobileForm.addEventListener('submit', (e) => {
      const val = mobileInput.value.trim();
      if (!val) {
        e.preventDefault();
        return;
      }
      mobileHiddenQ.value = `site:${domain} ${val}`;
    });
  }

  // Mobile menu toggle & interactions
  const toggleBtn = document.getElementById('mobile-nav-toggle') as HTMLButtonElement | null;
  const mobileMenu = document.getElementById('mobile-nav-menu') as HTMLElement | null;

  function openMenu() {
    if (!toggleBtn || !mobileMenu) return;
    toggleBtn.setAttribute('aria-expanded', 'true');
    toggleBtn.classList.add('is-active');
    mobileMenu.classList.add('is-open');
    mobileMenu.removeAttribute('hidden');
  }

  function closeMenu() {
    if (!toggleBtn || !mobileMenu) return;
    toggleBtn.setAttribute('aria-expanded', 'false');
    toggleBtn.classList.remove('is-active');
    mobileMenu.classList.remove('is-open');
    mobileMenu.setAttribute('hidden', '');
  }

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close when clicking outside header container
    document.addEventListener('click', (e) => {
      if (toggleBtn.getAttribute('aria-expanded') === 'true') {
        const target = e.target as Node;
        if (!toggleBtn.contains(target) && !mobileMenu.contains(target)) {
          closeMenu();
        }
      }
    });

    // Close on window resize to desktop viewport
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 680 && toggleBtn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    }, { passive: true });

    // Close menu when clicking any navigation link inside mobile menu
    mobileMenu.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }

  // Unified keyboard shortcut handler (Ctrl/Cmd+K for search, Escape to close menu)
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (window.innerWidth >= 680) {
        desktopInput?.focus();
      } else {
        if (toggleBtn && mobileMenu && (mobileMenu.hidden || !mobileMenu.classList.contains('is-open'))) {
          openMenu();
        }
        setTimeout(() => {
          mobileInput?.focus();
        }, 50);
      }
    } else if (e.key === 'Escape' && toggleBtn?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      toggleBtn.focus();
    }
  });
</script>
