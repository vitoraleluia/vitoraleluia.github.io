---
// ThemeToggle.astro: Icon-only theme toggle button (Dark / Light cycle, auto by default)
---

<button
  type="button"
  id="theme-toggle-btn"
  class="theme-toggle"
  data-theme-toggle
  aria-label="Toggle dark/light mode"
  title="Toggle dark/light mode"
>
  <!-- Sun icon: shown in dark mode (click to switch to light) -->
  <svg
    class="theme-icon icon-sun"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>

  <!-- Moon icon: shown in light mode (click to switch to dark) -->
  <svg
    class="theme-icon icon-moon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  const storageKey = 'starlight-theme';

  const updateLabels = () => {
    const isDark = document.documentElement.dataset.theme !== 'light';
    const label = isDark ? 'Switch to light mode' : 'Switch to dark mode';
    document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((btn) => {
      btn.setAttribute('aria-label', label);
      btn.setAttribute('title', label);
    });
  };

  const cycleTheme = () => {
    const currentTheme = document.documentElement.dataset.theme;
    const nextTheme = currentTheme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = nextTheme;
    try {
      localStorage.setItem(storageKey, nextTheme);
    } catch {}
    updateLabels();
  };

  // Wire up theme toggles
  document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      cycleTheme();
    });
  });

  // Initial update
  updateLabels();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    background: transparent;
    border: 1px solid var(--sl-color-gray-5, #27272a);
    border-radius: 6px;
    color: var(--sl-color-gray-2, #a1a1aa);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .theme-toggle:hover {
    color: var(--sl-color-white, #ededed);
    border-color: var(--sl-color-gray-4, #3f3f46);
    background-color: var(--sl-color-gray-6, #18181b);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--sl-color-accent, #e2a05a);
    outline-offset: 2px;
  }

  .theme-icon {
    pointer-events: none;
    transition: transform 0.2s ease;
  }

  /* When dark mode is active (default): show Sun, hide Moon */
  :global(:root:not([data-theme='light'])) .icon-sun,
  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }

  :global(:root:not([data-theme='light'])) .icon-moon,
  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }

  /* When light mode is active: show Moon, hide Sun */
  :global(:root[data-theme='light']) .icon-sun {
    display: none;
  }

  :global(:root[data-theme='light']) .icon-moon {
    display: block;
  }
</style>
