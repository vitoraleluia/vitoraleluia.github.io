---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Avatar from '../components/Avatar.astro';
import PostCard from '../components/PostCard.astro';
import { siteConfig } from '../site.config';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<StarlightPage
  frontmatter={{
    title: siteConfig.title,
    template: 'splash',
    head: [
      {
        tag: 'title',
        content: siteConfig.title,
      },
    ],
  }}
>
  <div class="max-w-3xl mx-auto px-4 pt-10 pb-16">
    <!-- Hero Section -->
    <section class="flex flex-col sm:flex-row items-start sm:items-center gap-7 sm:gap-9 pb-12 border-b border-ctp-surface0">
      <div class="shrink-0">
        <Avatar size="xl" />
      </div>
      <div class="flex flex-col gap-2.5">
        <h1 class="text-4xl font-bold tracking-tight text-ctp-text font-sans leading-tight m-0">{siteConfig.name}</h1>
        <p class="text-sm font-mono font-medium text-ctp-peach m-0">{siteConfig.role} &bull; {siteConfig.location}</p>
        <p class="text-base text-ctp-subtext1 leading-relaxed m-0">
          {siteConfig.bio}
        </p>
        <p class="text-sm text-ctp-subtext0 leading-normal m-0">
          I write technical articles about distributed systems, backend reliability, and developer tooling.
        </p>
        
        <div class="flex flex-wrap gap-2.5 mt-2">
          <a href="/blog/" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-md bg-ctp-peach text-white dark:text-ctp-base hover:opacity-90 transition-opacity duration-150 no-underline shadow-sm">
            Read Blog
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="/links/" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-md bg-white dark:bg-ctp-surface0 text-ctp-text border border-ctp-surface0 dark:border-ctp-surface1 hover:bg-ctp-mantle/50 dark:hover:bg-ctp-surface1 hover:border-ctp-peach dark:hover:border-ctp-surface2 transition-all duration-150 no-underline shadow-xs dark:shadow-none">
            Links
          </a>
          <a href={siteConfig.cvUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-md bg-transparent text-ctp-subtext0 border border-ctp-surface1 hover:text-ctp-peach hover:border-ctp-peach transition-colors duration-150 no-underline">
            CV (PDF)
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Recent Posts Section -->
    <section class="pt-11">
      <div class="flex justify-between items-baseline mb-6">
        <div>
          <h2 class="text-xl font-bold text-ctp-text font-sans m-0">Recent Posts</h2>
        </div>
        <a href="/blog/" class="text-sm font-medium text-ctp-peach hover:underline no-underline">
          All posts &rarr;
        </a>
      </div>

      <div class="flex flex-col gap-4">
        {recentPosts.map((post) => (
          <PostCard post={post} headingLevel="h3" />
        ))}
      </div>
    </section>
  </div>
</StarlightPage>
