---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import PostCard from '../components/PostCard.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { siteConfig } from '../site.config';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const emailLink = siteConfig.socialLinks.find((l) => l.icon === 'email')?.href ?? 'mailto:contact@vitoraleluia.com';
const linkedinLink = siteConfig.socialLinks.find((l) => l.icon === 'linkedin')?.href ?? 'https://linkedin.com/in/vitoraleluia';
const githubLink = siteConfig.socialLinks.find((l) => l.icon === 'github')?.href ?? 'https://github.com/VitorAleluia';
---

<BaseLayout title={siteConfig.title}>
  <div class="max-w-4xl mx-auto px-4 pt-10 pb-16">
    <!-- Hero Section -->
    <section class="flex flex-col sm:flex-row items-start sm:items-center gap-7 sm:gap-9 pb-12 border-b border-ctp-surface0">
      <div class="shrink-0">
        <Avatar size="xl" src={siteConfig.avatar} />
      </div>
      <div class="flex flex-col gap-2.5">
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-4xl font-bold tracking-tight text-ctp-text font-sans leading-tight m-0">{siteConfig.name}</h1>
          <div class="flex items-center gap-1 text-ctp-subtext0" aria-label="Social profiles and email">
            <a
              href={emailLink}
              class="inline-flex items-center justify-center p-1.5 text-ctp-subtext0 hover:text-ctp-peach hover:bg-ctp-surface0/60 rounded-md transition-colors duration-150 no-underline"
              aria-label="Email"
              title="Email"
            >
              <SocialIcons icon="email" size={20} />
            </a>
            <a
              href={linkedinLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center p-1.5 text-ctp-subtext0 hover:text-ctp-peach hover:bg-ctp-surface0/60 rounded-md transition-colors duration-150 no-underline"
              aria-label="LinkedIn"
              title="LinkedIn"
            >
              <SocialIcons icon="linkedin" size={20} />
            </a>
            <a
              href={githubLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center p-1.5 text-ctp-subtext0 hover:text-ctp-peach hover:bg-ctp-surface0/60 rounded-md transition-colors duration-150 no-underline"
              aria-label="GitHub"
              title="GitHub"
            >
              <SocialIcons icon="github" size={20} />
            </a>
          </div>
        </div>
        <p class="text-base text-ctp-subtext1 leading-relaxed m-0">
          {siteConfig.bio}
        </p>
        <p class="text-sm text-ctp-subtext0 leading-normal m-0">
          I write technical articles about distributed systems, backend reliability, and developer tooling.
        </p>
      </div>
    </section>

    <!-- Recent Posts Section -->
    <section class="pt-11">
      <div class="flex justify-between items-baseline mb-6">
        <div>
          <h2 class="text-xl font-bold text-ctp-text font-sans m-0">Recent Posts</h2>
        </div>
        <a href="/blog/" class="text-sm font-medium text-ctp-peach hover:underline no-underline">
          All posts &rarr;
        </a>
      </div>

      <div class="flex flex-col gap-4">
        {recentPosts.map((post) => (
          <PostCard post={post} headingLevel="h3" />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
