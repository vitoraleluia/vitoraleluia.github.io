---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const sorted = posts.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return sorted.map((post, index) => {
    const prevPost = index < sorted.length - 1 ? sorted[index + 1] : null;
    const nextPost = index > 0 ? sorted[index - 1] : null;
    return {
      params: { slug: post.id },
      props: { post, prevPost, nextPost },
    };
  });
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<StarlightPage
  frontmatter={{
    title: post.data.title,
    description: post.data.description,
    template: 'splash',
  }}
>
  <div class="w-full px-4 pt-8 pb-20">
    <div class="max-w-2xl mx-auto">
      <!-- Breadcrumb navigation -->
      <nav class="mb-8" aria-label="Breadcrumb">
        <a href="/blog/" class="inline-flex items-center gap-1.5 text-sm font-medium text-ctp-peach hover:underline no-underline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Back to all articles
        </a>
      </nav>

      <!-- Article Header -->
      <header class="pb-8 mb-10 border-b border-ctp-surface0">
        <div class="flex items-center flex-wrap gap-2 font-mono text-xs text-ctp-overlay2 mb-3.5">
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          <span class="opacity-50">&bull;</span>
          <span class="text-ctp-subtext0">{post.data.author}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ctp-text mb-4 font-sans leading-tight m-0">{post.data.title}</h1>

        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="font-mono text-xs text-ctp-subtext0 bg-ctp-surface0 border border-ctp-surface1 px-2 py-0.5 rounded">#{tag}</span>
          ))}
        </div>
      </header>

      <!-- Article Content (Libre Baskerville serif font for editorial reading) -->
      <div class="prose dark:prose-invert prose-headings:font-sans prose-headings:text-ctp-text prose-h2:text-2xl prose-h2:border-b prose-h2:border-ctp-surface0 prose-h2:pb-2 prose-h3:text-xl prose-p:font-serif prose-p:text-lg prose-p:leading-loose prose-p:text-ctp-subtext1 prose-a:text-ctp-peach prose-a:no-underline hover:prose-a:underline prose-code:font-mono prose-code:text-ctp-text prose-code:bg-ctp-surface0/60 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-pre:bg-ctp-mantle prose-pre:border prose-pre:border-ctp-surface0 prose-pre:rounded-lg prose-blockquote:border-l-2 prose-blockquote:border-l-ctp-peach prose-blockquote:text-ctp-subtext0 prose-blockquote:italic prose-li:text-ctp-subtext1 prose-li:font-serif prose-strong:text-ctp-text max-w-none">
        <Content />
      </div>

      <!-- Post Footer / Next & Previous Navigation -->
      <footer class="mt-16 pt-10 border-t border-ctp-surface0">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
          {prevPost ? (
            <a href={`/blog/${prevPost.id}/`} class="flex flex-col gap-1.5 p-5 bg-ctp-surface0/30 hover:bg-ctp-surface0/60 border border-ctp-surface0 hover:border-ctp-peach rounded-lg transition-colors duration-150 no-underline">
              <span class="font-mono text-xs text-ctp-peach">&larr; Older Article</span>
              <span class="font-sans text-sm font-semibold text-ctp-text line-clamp-2 leading-snug">{prevPost.data.title}</span>
            </a>
          ) : (
            <div class="hidden sm:block"></div>
          )}

          {nextPost ? (
            <a href={`/blog/${nextPost.id}/`} class="flex flex-col gap-1.5 p-5 bg-ctp-surface0/30 hover:bg-ctp-surface0/60 border border-ctp-surface0 hover:border-ctp-peach rounded-lg transition-colors duration-150 no-underline text-right">
              <span class="font-mono text-xs text-ctp-peach">Newer Article &rarr;</span>
              <span class="font-sans text-sm font-semibold text-ctp-text line-clamp-2 leading-snug">{nextPost.data.title}</span>
            </a>
          ) : (
            <div class="hidden sm:block"></div>
          )}
        </div>

        <div class="flex items-center justify-between text-sm">
          <a href="/blog/" class="text-ctp-subtext0 hover:text-ctp-peach no-underline transition-colors">
            &larr; Return to Blog Directory
          </a>
          <a href="#_top" class="text-ctp-subtext0 hover:text-ctp-peach no-underline transition-colors">
            Back to Top &uarr;
          </a>
        </div>
      </footer>
    </div>
  </div>
</StarlightPage>
