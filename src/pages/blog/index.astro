---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<StarlightPage frontmatter={{ title: 'Blog — Vitor Aleluia', template: 'splash' }}>
  <div class="blog-container">
    <header class="blog-header">
      <div class="blog-title-row">
        <h1 class="blog-title">Blog</h1>
        <a href="/rss.xml" class="rss-link" aria-label="RSS Feed">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 11a9 9 0 0 1 9 9"></path>
            <path d="M4 4a16 16 0 0 1 16 16"></path>
            <circle cx="5" cy="19" r="1"></circle>
          </svg>
          <span>RSS Feed</span>
        </a>
      </div>
      <p class="blog-subtitle">
        Articles, notes, and technical writeups on distributed systems and software architecture.
      </p>
    </header>

    <!-- Articles List -->
    <div class="articles-grid" id="articles-container">
      {sortedPosts.map((post) => (
        <article class="article-card">
          <div class="article-top-meta">
            <time datetime={post.data.pubDate.toISOString()} class="article-date">
              {formatDate(post.data.pubDate)}
            </time>
          </div>
          
          <h2 class="article-title">
            <a href={`/blog/${post.id}/`} class="article-link">
              {post.data.title}
            </a>
          </h2>

          <p class="article-description">{post.data.description}</p>
        </article>
      ))}
    </div>
  </div>
</StarlightPage>

<style>
  .blog-container {
    max-width: 50rem;
    margin: 0 auto;
    padding: 2.5rem 1rem 4rem;
  }

  .blog-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--sl-color-gray-5, #27272a);
  }

  .blog-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .blog-title {
    font-size: 2.25rem;
    line-height: 1.15;
    margin: 0;
    color: var(--sl-color-white, #ededed);
  }

  .blog-subtitle {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2, #a1a1aa);
    margin: 0;
    max-width: 48ch;
  }

  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--sl-color-accent, #e2a05a);
    text-decoration: none;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--sl-color-gray-5, #27272a);
    border-radius: 6px;
    background-color: var(--sl-color-gray-6, #18181b);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .rss-link:hover {
    color: var(--sl-color-white, #ededed);
    border-color: var(--sl-color-accent, #e2a05a);
  }

  /* Articles List */
  .articles-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    padding: 1.35rem;
    background-color: var(--sl-color-gray-6, rgba(255, 255, 255, 0.02));
    border: 1px solid var(--sl-color-gray-5, #27272a);
    border-radius: 8px;
    transition: border-color 0.15s ease;
  }

  .article-card:hover {
    border-color: var(--sl-color-accent, #e2a05a);
  }

  .article-top-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .article-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--sl-color-gray-3, #71717a);
  }

  .article-title {
    font-size: 1.25rem;
    line-height: 1.3;
    margin: 0 0 0.5rem;
  }

  .article-link {
    color: var(--sl-color-white, #ededed);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .article-link:hover {
    color: var(--sl-color-accent, #e2a05a);
  }

  .article-description {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2, #a1a1aa);
    margin: 0;
  }
</style>
