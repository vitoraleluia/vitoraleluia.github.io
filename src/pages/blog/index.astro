---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<StarlightPage frontmatter={{ title: 'Blog', template: 'splash' }}>
  <div class="max-w-4xl mx-auto px-4 pt-10 pb-16">
    <header class="mb-10 pb-6 border-b border-ctp-surface0">
      <div class="flex items-center justify-between gap-4 mb-2">
        <h1 class="text-3xl font-bold tracking-tight text-ctp-text font-sans m-0">Blog</h1>
        <a href="/rss.xml" class="inline-flex items-center gap-1.5 font-mono text-xs text-ctp-peach hover:text-ctp-text px-2.5 py-1 border border-ctp-surface0 dark:border-ctp-surface1 hover:border-ctp-peach bg-white dark:bg-ctp-surface0 rounded-md transition-all duration-150 no-underline shadow-xs dark:shadow-none" aria-label="RSS Feed">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 11a9 9 0 0 1 9 9"></path>
            <path d="M4 4a16 16 0 0 1 16 16"></path>
            <circle cx="5" cy="19" r="1"></circle>
          </svg>
          <span>RSS Feed</span>
        </a>
      </div>
      <p class="text-base text-ctp-subtext0 max-w-[48ch] leading-relaxed m-0">
        Articles, notes, and technical writeups on distributed systems and software architecture.
      </p>
    </header>

    <!-- Articles List -->
    <div class="flex flex-col gap-5" id="articles-container">
      {sortedPosts.map((post) => (
        <PostCard post={post} headingLevel="h2" />
      ))}
    </div>
  </div>
</StarlightPage>
