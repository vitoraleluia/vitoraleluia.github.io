---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Collect unique tags
const allTags = Array.from(
  new Set(allPosts.flatMap((post) => post.data.tags || []))
).sort();

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

function calculateReadingTime(content: string) {
  const words = content.split(/\s+/).length;
  const minutes = Math.max(1, Math.ceil(words / 200));
  return `${minutes} min read`;
}
---

<StarlightPage frontmatter={{ title: 'Blog — Vitor Aleluia', template: 'splash' }}>
  <div class="blog-container">
    <header class="blog-header">
      <h1 class="blog-title">Blog</h1>
      <p class="blog-subtitle">
        Articles, notes, and technical writeups on distributed systems and software architecture.
      </p>
      <div class="blog-meta-bar">
        <span class="posts-count">{sortedPosts.length} posts in total</span>
        <a href="/rss.xml" class="rss-link">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 11a9 9 0 0 1 9 9"></path>
            <path d="M4 4a16 16 0 0 1 16 16"></path>
            <circle cx="5" cy="19" r="1"></circle>
          </svg>
          RSS Feed
        </a>
      </div>

      <!-- Tag Filters -->
      {allTags.length > 0 && (
        <div class="tag-filter-container">
          <button class="tag-btn active" data-tag="all">All</button>
          {allTags.map((tag) => (
            <button class="tag-btn" data-tag={tag}>
              #{tag}
            </button>
          ))}
        </div>
      )}
    </header>

    <!-- Articles List -->
    <div class="articles-grid" id="articles-container">
      {sortedPosts.map((post) => (
        <article class="article-card" data-tags={JSON.stringify(post.data.tags || [])}>
          <div class="article-top-meta">
            <time datetime={post.data.pubDate.toISOString()} class="article-date">
              {formatDate(post.data.pubDate)}
            </time>
            <span class="reading-time">{calculateReadingTime(post.body || '')}</span>
          </div>
          
          <h2 class="article-title">
            <a href={`/blog/${post.id}/`} class="article-link">
              {post.data.title}
            </a>
          </h2>

          <p class="article-description">{post.data.description}</p>

          <div class="article-tags">
            {post.data.tags.map((tag) => (
              <span class="tag-badge">#{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</StarlightPage>

<script>
  // Client-side tag filtering
  const tagButtons = document.querySelectorAll('.tag-btn');
  const articles = document.querySelectorAll<HTMLElement>('.article-card');

  tagButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selectedTag = btn.getAttribute('data-tag');

      tagButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      articles.forEach((article) => {
        if (selectedTag === 'all') {
          article.style.display = 'flex';
        } else {
          const tags: string[] = JSON.parse(article.getAttribute('data-tags') || '[]');
          if (tags.includes(selectedTag || '')) {
            article.style.display = 'flex';
          } else {
            article.style.display = 'none';
          }
        }
      });
    });
  });
</script>

<style>
  .blog-container {
    max-width: 50rem;
    margin: 0 auto;
    padding: 2.5rem 1rem 4rem;
  }

  .blog-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--sl-color-gray-5, #27272a);
  }

  .blog-title {
    font-size: 2.25rem;
    line-height: 1.15;
    margin: 0 0 0.5rem;
    color: var(--sl-color-white, #ededed);
  }

  .blog-subtitle {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2, #a1a1aa);
    margin: 0 0 1.25rem;
    max-width: 48ch;
  }

  .blog-meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .posts-count {
    font-family: var(--font-mono);
    font-size: 0.825rem;
    color: var(--sl-color-gray-3, #71717a);
  }

  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.825rem;
    color: var(--sl-color-accent, #e2a05a);
    text-decoration: none;
  }

  .rss-link:hover {
    text-decoration: underline;
  }

  .tag-filter-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-btn {
    background-color: var(--sl-color-gray-6, #18181b);
    color: var(--sl-color-gray-2, #a1a1aa);
    border: 1px solid var(--sl-color-gray-5, #27272a);
    padding: 0.25rem 0.65rem;
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 0.775rem;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .tag-btn:hover {
    color: var(--sl-color-white, #ededed);
    border-color: var(--sl-color-gray-4, #3f3f46);
  }

  .tag-btn.active {
    background-color: var(--sl-color-accent-low, rgba(226, 160, 90, 0.15));
    color: var(--sl-color-accent, #e2a05a);
    border-color: var(--sl-color-accent, #e2a05a);
    font-weight: 600;
  }

  /* Articles List */
  .articles-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    padding: 1.35rem;
    background-color: var(--sl-color-gray-6, rgba(255, 255, 255, 0.02));
    border: 1px solid var(--sl-color-gray-5, #27272a);
    border-radius: 8px;
    transition: border-color 0.15s ease;
  }

  .article-card:hover {
    border-color: var(--sl-color-accent, #e2a05a);
  }

  .article-top-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .article-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--sl-color-gray-3, #71717a);
  }

  .reading-time {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    color: var(--sl-color-gray-3, #71717a);
  }

  .article-title {
    font-size: 1.25rem;
    line-height: 1.3;
    margin: 0 0 0.5rem;
  }

  .article-link {
    color: var(--sl-color-white, #ededed);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .article-link:hover {
    color: var(--sl-color-accent, #e2a05a);
  }

  .article-description {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2, #a1a1aa);
    margin: 0 0 0.85rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
  }

  .tag-badge {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    color: var(--sl-color-gray-3, #71717a);
    background-color: var(--sl-color-gray-6, #18181b);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid var(--sl-color-gray-5, #27272a);
  }
</style>
