---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Avatar from '../components/Avatar.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { siteConfig } from '../site.config';

const links = [
  {
    title: 'Personal Blog',
    subtitle: 'Read technical articles & notes',
    href: '/blog/',
    icon: 'link' as const,
    featured: true,
  },
  {
    title: 'Curriculum Vitae',
    subtitle: 'View & download resume (PDF)',
    href: siteConfig.cvUrl,
    icon: 'link' as const,
    target: '_blank',
    rel: 'noopener noreferrer',
  },
  {
    title: 'GitHub',
    subtitle: 'Open source code & repositories',
    href: 'https://github.com/VitorAleluia',
    icon: 'github' as const,
    target: '_blank',
    rel: 'noopener noreferrer',
  },
  {
    title: 'LinkedIn',
    subtitle: 'Professional profile & background',
    href: 'https://linkedin.com/in/vitoraleluia',
    icon: 'linkedin' as const,
    target: '_blank',
    rel: 'noopener noreferrer',
  },
  {
    title: 'X (Twitter)',
    subtitle: 'Thoughts & short-form tech posts',
    href: 'https://x.com',
    icon: 'x' as const,
    target: '_blank',
    rel: 'noopener noreferrer',
  },
  {
    title: 'Email',
    subtitle: 'contact@vitoraleluia.dev',
    href: 'mailto:contact@vitoraleluia.dev',
    icon: 'email' as const,
  },
  {
    title: 'RSS Feed',
    subtitle: 'Subscribe in your favorite feed reader',
    href: '/rss.xml',
    icon: 'rss' as const,
    target: '_blank',
  },
];
---

<StarlightPage frontmatter={{ title: 'Links — Vitor Aleluia', template: 'splash' }}>
  <div class="links-page-wrapper">
    <!-- Centered Header with Photo -->
    <header class="links-header">
      <div class="links-avatar-wrapper">
        <Avatar size="xl" />
      </div>
      <h1 class="links-title">{siteConfig.name}</h1>
      <p class="links-role">{siteConfig.role}</p>
      <p class="links-bio">
        Software engineer passionate about high-performance systems and developer tooling.
      </p>
    </header>

    <!-- Centered Link Buttons Stack -->
    <nav class="links-list" aria-label="Social and Web Links">
      {links.map((link) => (
        <a
          href={link.href}
          target={link.target}
          rel={link.rel}
          class={`link-card ${link.featured ? 'is-featured' : ''}`}
        >
          <div class="link-icon-box">
            <SocialIcons icon={link.icon} size={22} />
          </div>
          <div class="link-info">
            <span class="link-title">{link.title}</span>
            {link.subtitle && <span class="link-subtitle">{link.subtitle}</span>}
          </div>
          <div class="link-arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </div>
        </a>
      ))}
    </nav>

    <footer class="links-footer">
      <p>&copy; {new Date().getFullYear()} {siteConfig.name}</p>
    </footer>
  </div>
</StarlightPage>

<style>
  .links-page-wrapper {
    max-width: 27rem;
    margin: 1.5rem auto 4rem;
    padding: 1rem 1rem 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .links-header {
    text-align: center;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .links-avatar-wrapper {
    margin-bottom: 1.25rem;
  }

  .links-title {
    font-size: 1.75rem;
    line-height: 1.2;
    margin: 0 0 0.35rem;
    color: var(--sl-color-white, #ededed);
    letter-spacing: -0.02em;
  }

  .links-role {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--sl-color-accent, #e2a05a);
    margin: 0 0 0.75rem;
  }

  .links-bio {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2, #a1a1aa);
    margin: 0;
    max-width: 34ch;
  }

  /* Link Cards */
  .links-list {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .link-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.15rem;
    background-color: var(--sl-color-gray-6, rgba(255, 255, 255, 0.03));
    border: 1px solid var(--sl-color-gray-5, #27272a);
    border-radius: 8px;
    text-decoration: none;
    color: var(--sl-color-white, #ededed);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .link-card:hover {
    border-color: var(--sl-color-accent, #e2a05a);
  }

  .link-card.is-featured {
    border-color: var(--sl-color-accent, #e2a05a);
  }

  .link-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--sl-color-accent, #e2a05a);
  }

  .link-info {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
  }

  .link-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--sl-color-white, #ededed);
  }

  .link-subtitle {
    font-size: 0.775rem;
    color: var(--sl-color-gray-3, #71717a);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .link-arrow {
    display: flex;
    align-items: center;
    color: var(--sl-color-gray-4, #52525b);
    transition: transform 0.15s ease, color 0.15s ease;
    flex-shrink: 0;
  }

  .link-card:hover .link-arrow {
    color: var(--sl-color-accent, #e2a05a);
  }

  .links-footer {
    margin-top: 3rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--sl-color-gray-4, #52525b);
  }
</style>
