---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { siteConfig } from '../site.config';

const links = [
  {
    title: 'Personal Blog',
    href: '/blog/',
    icon: 'link' as const,
    featured: true,
  },
  {
    title: 'Curriculum Vitae',
    href: siteConfig.cvUrl,
    icon: 'link' as const,
    target: '_blank',
    rel: 'noopener noreferrer',
  },
  {
    title: 'GitHub',
    href: 'https://github.com/VitorAleluia',
    icon: 'github' as const,
    target: '_blank',
    rel: 'noopener noreferrer',
  },
  {
    title: 'LinkedIn',
    href: 'https://linkedin.com/in/vitoraleluia',
    icon: 'linkedin' as const,
    target: '_blank',
    rel: 'noopener noreferrer',
  },
  {
    title: 'Email',
    href: 'mailto:contact@vitoraleluia.dev',
    icon: 'email' as const,
  },
  {
    title: 'RSS Feed',
    href: '/rss.xml',
    icon: 'rss' as const,
    target: '_blank',
  },
];
---

<BaseLayout title="Links">
  <div class="max-w-xl mx-auto px-5 pt-8 pb-14 flex flex-col items-center">
    <!-- Centered Header with Photo -->
    <header class="text-center mb-8 flex flex-col items-center">
      <div class="mb-5">
        <Avatar size="xl" />
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-ctp-text font-sans mb-1.5 leading-tight m-0">{siteConfig.name}</h1>
      <p class="font-mono text-sm text-ctp-peach mb-3 m-0">{siteConfig.role}</p>
      <p class="text-sm text-ctp-subtext0 leading-relaxed max-w-md m-0">
        Software engineer passionate about high-performance systems and developer tooling.
      </p>
    </header>

    <!-- Centered Link Buttons Stack -->
    <nav class="w-full flex flex-col gap-3.5" aria-label="Social and Web Links">
      {links.map((link) => (
        <a
          href={link.href}
          target={link.target}
          rel={link.rel}
          class:list={[
            'flex items-center gap-4 px-4 py-4 rounded-lg text-ctp-text transition-all duration-150 no-underline group border',
            link.featured
              ? 'bg-ctp-surface0/70 border-ctp-peach/70 hover:border-ctp-peach hover:bg-ctp-surface0'
              : 'bg-ctp-surface0/40 hover:bg-ctp-surface0/80 border-ctp-surface0 hover:border-ctp-peach',
          ]}
        >
          <div class="flex items-center justify-center shrink-0 text-ctp-peach">
            <SocialIcons icon={link.icon} size={22} />
          </div>
          <span class="grow text-sm font-semibold text-ctp-text group-hover:text-ctp-peach transition-colors leading-snug">{link.title}</span>
          <div class="flex items-center text-ctp-overlay0 group-hover:text-ctp-peach group-hover:translate-x-0.5 shrink-0 transition-all duration-150">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </div>
        </a>
      ))}
    </nav>
  </div>
</BaseLayout>
